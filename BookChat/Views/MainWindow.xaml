<Window x:Class="BookChat.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BookChat.Views"
        xmlns:prism="http://prismlibrary.com/"
        prism:ViewModelLocator.AutoWireViewModel="True"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Height="800" Width="1100"
        MinHeight="400" MinWidth="600"
        Icon="/Resources/favicon.ico">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <local:InverseBooleanConverter x:Key="InverseBoolConverter"/>
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Main TabControl -->
        <TabControl Grid.Row="0" Margin="5">

            <!-- Find Books Tab -->
            <TabItem Header="Find Books">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Book Search Panel -->
                    <GroupBox Grid.Row="0" Header="Book Search" Margin="5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Author:" VerticalAlignment="Center" Margin="5"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding AuthorName, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="5" Padding="5" IsEnabled="{Binding IsConnected}"/>

                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Book Title:" VerticalAlignment="Center" Margin="5"/>
                            <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding BookTitle, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="5" Padding="5" IsEnabled="{Binding IsConnected}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding FetchCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>

                            <Button Grid.Row="0" Grid.Column="4" Content="Fetch" Command="{Binding FetchCommand}"
                                    Margin="5" Padding="20,5" FontWeight="SemiBold"
                                    Background="#FF3498DB" Foreground="White"/>

                            <!-- Search Status Line -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5"
                                       Text="{Binding SearchStatus}"
                                       Margin="5,0,5,5" Padding="5"
                                       FontStyle="Italic"
                                       Foreground="#FF7F8C8D"
                                       TextWrapping="Wrap"/>
                        </Grid>
                    </GroupBox>

                    <!-- Search Results -->
                    <GroupBox Grid.Row="1" Header="Search Results" Margin="5">
                        <DataGrid ItemsSource="{Binding SearchResults}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserResizeRows="False"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column"
                                  AlternatingRowBackground="#FFF9F9F9"
                                  RowHeight="30"
                                  FontSize="12">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Author" Binding="{Binding Author}" Width="150"/>
                                <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*" MinWidth="200"/>
                                <DataGridTextColumn Header="Format" Binding="{Binding Format}" Width="70"/>
                                <DataGridTextColumn Header="Size" Binding="{Binding FileSize}" SortMemberPath="FileSizeInBytes" Width="80"/>
                                <DataGridTextColumn Header="Language" Binding="{Binding Language}" Width="80"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                                <DataGridTemplateColumn Header="Action" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Download"
                                                    Command="{Binding DataContext.DownloadBookCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Padding="10,3"
                                                    Background="#FF27AE60"
                                                    Foreground="White"
                                                    FontWeight="SemiBold"
                                                    BorderThickness="0"
                                                    Cursor="Hand"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- Settings Tab -->
            <TabItem Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!-- IRC Connection Settings -->
                        <GroupBox Header="IRC Connection" Margin="5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Row 0: Server and Port -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Server:" VerticalAlignment="Center" Margin="5"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Server, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="5" Padding="5" IsEnabled="{Binding IsConnected, Converter={StaticResource InverseBoolConverter}}"/>

                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Port:" VerticalAlignment="Center" Margin="5"/>
                                <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="5" Padding="5" IsEnabled="{Binding IsConnected, Converter={StaticResource InverseBoolConverter}}"/>

                                <TextBlock Grid.Row="0" Grid.Column="4" Text="Nickname:" VerticalAlignment="Center" Margin="5"/>
                                <TextBox Grid.Row="0" Grid.Column="5" Text="{Binding Nickname, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="5" Padding="5" IsEnabled="{Binding IsConnected, Converter={StaticResource InverseBoolConverter}}"/>

                                <Button Grid.Row="0" Grid.Column="6" Grid.RowSpan="2" Content="Connect"
                                        Command="{Binding ConnectCommand}"
                                        Margin="5" Padding="10,5" FontWeight="Bold"
                                        Visibility="{Binding IsConnected, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                                <Button Grid.Row="0" Grid.Column="6" Grid.RowSpan="2" Content="Disconnect"
                                        Command="{Binding DisconnectCommand}"
                                        Margin="5" Padding="10,5" FontWeight="Bold" Background="#FFE74C3C" Foreground="White"
                                        Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                <!-- Row 1: Channel -->
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Channel:" VerticalAlignment="Center" Margin="5"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="5"
                                         Text="{Binding Channel, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="5" Padding="5" IsEnabled="{Binding IsConnected, Converter={StaticResource InverseBoolConverter}}"/>
                            </Grid>
                        </GroupBox>

                        <!-- Calibre Integration Settings -->
                        <GroupBox Header="Calibre Integration" Margin="5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Row 0: Library Path, Auto-Import, Duplicates -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Library Path:" VerticalAlignment="Center" Margin="5"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding CalibreLibraryPath, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="5" Padding="5" ToolTip="Path to your Calibre library directory"/>

                                <CheckBox Grid.Row="0" Grid.Column="2" Content="Auto-Import Downloads"
                                          IsChecked="{Binding AutoImportToCalibre}"
                                          VerticalAlignment="Center" Margin="15,5,5,5"
                                          ToolTip="Automatically add downloaded books to Calibre library"/>

                                <TextBlock Grid.Row="0" Grid.Column="3" Text="Duplicates:" VerticalAlignment="Center" Margin="10,5,5,5"/>
                                <ComboBox Grid.Row="0" Grid.Column="4" SelectedValue="{Binding CalibreDuplicateHandling}"
                                          SelectedValuePath="Tag"
                                          Margin="5" Padding="5" ToolTip="How to handle duplicate books">
                                    <ComboBoxItem Content="Ignore duplicates" Tag="ignore" IsSelected="True"/>
                                    <ComboBoxItem Content="Overwrite duplicates" Tag="overwrite"/>
                                    <ComboBoxItem Content="Create new record" Tag="new_record"/>
                                </ComboBox>

                                <!-- Row 1: Content Server URL -->
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Server URL:" VerticalAlignment="Center" Margin="5"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4"
                                         Text="{Binding CalibreContentServerUrl, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="5" Padding="5"
                                         ToolTip="URL of Calibre content server (used when Calibre is running). Default: http://localhost:8080"/>

                                <!-- Row 2: Username and Password -->
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Username:" VerticalAlignment="Center" Margin="5"/>
                                <TextBox Grid.Row="2" Grid.Column="1"
                                         Text="{Binding CalibreUsername, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="5" Padding="5"
                                         ToolTip="Username for content server authentication (when Calibre is running)"/>

                                <TextBlock Grid.Row="2" Grid.Column="2" Text="Password:" VerticalAlignment="Center" Margin="15,5,5,5"/>
                                <PasswordBox Grid.Row="2" Grid.Column="3" Grid.ColumnSpan="2"
                                             x:Name="CalibrePasswordBox"
                                             Margin="5" Padding="5"
                                             ToolTip="Password for content server authentication (when Calibre is running)"
                                             PasswordChanged="CalibrePasswordBox_PasswordChanged"/>
                            </Grid>
                        </GroupBox>

                        <!-- IRC Chat Messages -->
                        <GroupBox Header="IRC Chat Messages" Margin="5">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="300" MinHeight="100"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Chat Messages -->
                                <Border Grid.Row="0" BorderBrush="#FFBDC3C7" BorderThickness="1">
                                    <ListBox x:Name="MessagesListBox"
                                             ItemsSource="{Binding Messages}"
                                             FontFamily="Consolas"
                                             FontSize="12"
                                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             ScrollViewer.CanContentScroll="False"
                                             Background="#FFF5F5F5"
                                             local:AutoScrollBehavior.AutoScroll="True">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="5,2"/>
                                                <Setter Property="Margin" Value="0"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>

                                <!-- Message Input -->
                                <Grid Grid.Row="1" Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox Grid.Column="0"
                                             Text="{Binding MessageToSend, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="8"
                                             FontSize="13"
                                             IsEnabled="{Binding IsConnected}">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Return" Command="{Binding SendMessageCommand}"/>
                                        </TextBox.InputBindings>
                                    </TextBox>

                                    <Button Grid.Column="1"
                                            Content="Send"
                                            Command="{Binding SendMessageCommand}"
                                            Margin="5,0,0,0"
                                            Padding="20,8"
                                            FontWeight="SemiBold"
                                            Background="#FF27AE60"
                                            Foreground="White"/>
                                </Grid>
                            </Grid>
                        </GroupBox>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- About Tab -->
            <TabItem Header="About">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">

                        <!-- App Title -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Image Source="/Resources/favicon.ico" Width="40" Height="40" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="BookChat" FontSize="32" FontWeight="Bold" Foreground="#FF2C3E50" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="IRC E-Book Downloader" FontSize="16" Foreground="#FF7F8C8D" Margin="0,0,0,20"/>

                        <!-- Version Info -->
                        <Border Background="#FFF8F9FA" Padding="15" Margin="0,0,0,20" CornerRadius="5">
                            <StackPanel>
                                <TextBlock Text="Version Information" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <TextBlock Text="Version: 1.1.0" FontSize="12" Margin="0,0,0,5"/>
                                <TextBlock Text=".NET 9.0" FontSize="12" Margin="0,0,0,5"/>
                                <TextBlock Text="Build Date: December 31, 2025" FontSize="12"/>
                            </StackPanel>
                        </Border>

                        <!-- Description -->
                        <Border Background="#FFF8F9FA" Padding="15" Margin="0,0,0,20" CornerRadius="5">
                            <StackPanel>
                                <TextBlock Text="About This Application" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="20">
                                    BookChat is a WPF desktop application that connects to IRC networks to search for and download e-books.
                                    It features automatic Calibre library integration, allowing downloaded books to be automatically imported
                                    into your Calibre library for easy organization and management.
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Features -->
                        <Border Background="#FFF8F9FA" Padding="15" Margin="0,0,0,20" CornerRadius="5">
                            <StackPanel>
                                <TextBlock Text="Key Features" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <StackPanel Margin="10,0,0,0">
                                    <TextBlock Text="• IRC-based e-book searching and downloading" FontSize="12" Margin="0,0,0,5"/>
                                    <TextBlock Text="• DCC file transfer protocol support" FontSize="12" Margin="0,0,0,5"/>
                                    <TextBlock Text="• Automatic Calibre library integration" FontSize="12" Margin="0,0,0,5"/>
                                    <TextBlock Text="• Real-time download progress tracking" FontSize="12" Margin="0,0,0,5"/>
                                    <TextBlock Text="• Configurable duplicate handling" FontSize="12" Margin="0,0,0,5"/>
                                    <TextBlock Text="• Persistent settings storage" FontSize="12" Margin="0,0,0,5"/>
                                    <TextBlock Text="• Auto-connect on startup" FontSize="12"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Technologies -->
                        <Border Background="#FFF8F9FA" Padding="15" Margin="0,0,0,20" CornerRadius="5">
                            <StackPanel>
                                <TextBlock Text="Technologies Used" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <StackPanel Margin="10,0,0,0">
                                    <TextBlock Text="• WPF (Windows Presentation Foundation)" FontSize="12" Margin="0,0,0,5"/>
                                    <TextBlock Text="• .NET 9.0" FontSize="12" Margin="0,0,0,5"/>
                                    <TextBlock Text="• Prism MVVM Framework 9.0" FontSize="12" Margin="0,0,0,5"/>
                                    <TextBlock Text="• SmartIrc4net Library 1.1.0" FontSize="12" Margin="0,0,0,5"/>
                                    <TextBlock Text="• Calibre (calibredb CLI integration)" FontSize="12"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Developer Info -->
                        <Border Background="#FFF8F9FA" Padding="15" Margin="0,0,0,20" CornerRadius="5">
                            <StackPanel>
                                <TextBlock Text="Developer" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <TextBlock Text="Developed with assistance from Claude (Anthropic)" FontSize="12" Margin="0,0,0,5"/>
                                <TextBlock Text="© 2025 BookChat" FontSize="12"/>
                            </StackPanel>
                        </Border>

                        <!-- System Info -->
                        <Border Background="#FFF8F9FA" Padding="15" CornerRadius="5">
                            <StackPanel>
                                <TextBlock Text="System Information" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <StackPanel Margin="10,0,0,0">
                                    <TextBlock FontSize="12" Margin="0,0,0,5">
                                        <Run Text="Downloads Directory: "/>
                                        <Run Text="{Binding DownloadDirectory, Mode=OneWay}" FontFamily="Consolas" FontSize="11"/>
                                    </TextBlock>
                                    <TextBlock FontSize="12" Margin="0,0,0,5">
                                        <Run Text="Temp Directory: "/>
                                        <Run Text="{Binding SearchResultsTempDirectory, Mode=OneWay}" FontFamily="Consolas" FontSize="11"/>
                                    </TextBlock>
                                    <TextBlock FontSize="12">
                                        <Run Text="Settings File: "/>
                                        <Run Text="%APPDATA%\BookChat\calibre-settings.json" FontFamily="Consolas" FontSize="11"/>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <!-- Status Bar -->
        <Border Grid.Row="1" Background="#FF34495E" Padding="10,5">
            <TextBlock Text="{Binding StatusMessage}" Foreground="White" FontWeight="SemiBold"/>
        </Border>

        <!-- Instructions -->
        <Border Grid.Row="2" Background="#FFECF0F1" Padding="10,5" BorderBrush="#FFBDC3C7" BorderThickness="0,1,0,0">
            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#FF7F8C8D">
                <Run FontWeight="Bold">Quick Start:</Run>
                <Run>The app auto-connects to #ebooks on IRCHighway.</Run>
                <Run FontWeight="SemiBold">Search for books:</Run>
                <Run>Enter Author and/or Book Title in the Find Books tab, then click Fetch to search.</Run>
                <Run FontWeight="SemiBold">Settings:</Run>
                <Run>Configure IRC connection and Calibre integration in the Settings tab.</Run>
            </TextBlock>
        </Border>
    </Grid>
</Window>
